# Use 0.0.0.0 para acesso direto pelo IP; 127.0.0.1 para proxy HTTPS local.
APP_BIND=127.0.0.1
APP_PORT=8080

# MySQL local para administrar pelo phpMyAdmin; configure senhas fortes.
GP4_DB_NAME=gp4
GP4_DB_USER=gp4
GP4_DB_PASSWORD=altere-esta-senha-local
GP4_DB_ROOT_PASSWORD=altere-esta-senha-root-local
GP4_DB_PORT=3306
