# Somente desenvolvimento local; não há conexão com banco ou frontend.
APP_ENV=local
# Dados nativos ficam por padrão em ../.gp4/ fora do repositório.
# STORAGE_PATH=/caminho/privado/state.json
TOKEN_TTL=28800
MAX_UPLOAD_BYTES=5242880
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
# Para executar migrations com PHP CLI habilitado com pdo_pgsql:
# DATABASE_DSN=pgsql:host=127.0.0.1;port=5432;dbname=gp4
# DATABASE_USER=gp4
# DATABASE_PASSWORD=configure-a-mesma-senha-do-compose
