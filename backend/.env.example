# Desenvolvimento local; sem DATABASE_DSN a API usa JSON.
APP_ENV=local
# Dados nativos ficam por padrão em ../.gp4/ fora do repositório.
# STORAGE_PATH=/caminho/privado/state.json
TOKEN_TTL=28800
MAX_UPLOAD_BYTES=5242880
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
# Para usar MySQL local após aplicar as migrations (requer pdo_mysql):
# DATABASE_DSN=mysql:host=127.0.0.1;port=3306;dbname=gp4;charset=utf8mb4
# DATABASE_USER=gp4
# DATABASE_PASSWORD=configure-a-mesma-senha-do-compose

# Supabase PostgreSQL (configuração privada do servidor, não do frontend).
# DATABASE_DSN=pgsql:host=SEU_HOST;port=5432;dbname=postgres;sslmode=require
# DATABASE_USER=postgres
# DATABASE_PASSWORD=configure-no-gerenciador-de-segredos
